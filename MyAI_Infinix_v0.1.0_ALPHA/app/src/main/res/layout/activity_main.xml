<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <ScrollView
        android:id="@+id/controlScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.15"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MyAI — Инфиникс"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp" />

            <Button
                android:id="@+id/accessibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Открыть специальные возможности" />

            <Button
                android:id="@+id/testHome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Тест: Домой" />

            <Button
                android:id="@+id/testBack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Тест: Назад" />

            <Button
                android:id="@+id/testScreen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Тест: Прочитать экран" />

            <Button
                android:id="@+id/testTool"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Тест: Tool Protocol (Home)" />

            <Button
                android:id="@+id/testScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Тест: Прокрутка вниз" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:text="Журнал действий"
        android:textStyle="bold" />

    <ScrollView
        android:id="@+id/logScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:textSize="13sp" />
    </ScrollView>
</LinearLayout>
